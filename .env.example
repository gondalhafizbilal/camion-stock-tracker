# Camion Backend API
CAMION_API_URL=you-camion-api-url
CAMION_API_SECRET=your-api-secret
DEFAULT_WAREHOUSE_UUID=your-camion-warehouse-uuid

# Gulltrans API
GULLTRANS_BASE_URL=https://api.gulltrans.com
GULLTRANS_AUTHORIZATION=your-auth-token
GULLTRANS_UUID=your-uuid

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_DATABASE=camion_tracker

# Application
NODE_ENV=local
APP_NAME=camion-stock-tracker
PORT=3001
LOG_LEVEL=info
BATCH_SIZE=50
CONCURRENT_REQUESTS=5
RATE_LIMIT_DELAY=1000